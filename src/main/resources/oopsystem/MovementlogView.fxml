<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="700.0" prefWidth="1209.0" stylesheets="@styling/MovementlogView.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="oopsystem.controller.MovementLogController">

    <left>
        <VBox prefWidth="230.0" styleClass="sidebar">
            <padding><Insets top="16.0" /></padding>
            <children>
                <VBox alignment="CENTER" prefHeight="80.0">
                    <children>
                        <Label styleClass="sidebar-title" text="Admin Portal">
                     <font>
                        <Font size="22.0" />
                     </font></Label>
                        <Label styleClass="sidebar-subtitle" text="Pass Slip System" />
                    </children>
                </VBox>

                <Button maxWidth="Infinity" onAction="#goToDashboard" prefHeight="52.0" styleClass="sidebar-btn" text="  Dashboard" />
                <Button maxWidth="Infinity" onAction="#goToPassSlipIssuance" prefHeight="52.0" styleClass="sidebar-btn" text="  Issue Pass Slip" />
                <Button maxWidth="Infinity" onAction="#goToMovementLogs" prefHeight="52.0" styleClass="sidebar-btn-active" text="  Movement Logs" />
                <Button maxWidth="Infinity" onAction="#goToEmployeeDirectory" prefHeight="52.0" styleClass="sidebar-btn" text="  Employee Directory" />
                <Button maxWidth="Infinity" onAction="#gotoReports" prefHeight="52.0" styleClass="sidebar-btn" text="  Reports" />

                <Pane VBox.vgrow="ALWAYS" />

                <Button maxWidth="Infinity" prefHeight="52.0" styleClass="sidebar-btn" text="  Settings" />
                <Button maxWidth="Infinity" prefHeight="52.0" styleClass="sidebar-btn" text="  Logout" />
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="14.0">
            <padding><Insets bottom="20.0" left="22.0" right="22.0" top="15.0" /></padding>

            <!-- TOP BAR -->
            <HBox alignment="CENTER_LEFT">
                <Label styleClass="top-bar-title" text="Pass Slip Management" />
                <Pane HBox.hgrow="ALWAYS" />
                <Button styleClass="icon-btn" text="🔔" />
                <Button styleClass="icon-btn" text="?" />
                <Button styleClass="icon-btn" text="👤" />
            </HBox>

            <!-- PAGE TITLE -->
            <VBox spacing="2.0">
                <Label styleClass="page-title" text="Movement Logs" />
                <Label styleClass="page-subtitle" text="Personnel Time-In/Out and Gate Pass Records" />
            </VBox>

            <!-- FILTERS -->
            <VBox spacing="10.0" styleClass="content-box">
                <padding><Insets bottom="14.0" left="16.0" right="16.0" top="14.0" /></padding>
                <HBox alignment="CENTER_LEFT" spacing="14.0">
                    <VBox spacing="4.0">
                        <Label styleClass="filter-label" text="DATE RANGE" />
                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                            <DatePicker fx:id="startDatePicker" prefWidth="148.0" promptText="mm/dd/yyyy" />
                            <Label text="to" />
                            <DatePicker fx:id="endDatePicker" prefWidth="148.0" promptText="mm/dd/yyyy" />
                        </HBox>
                    </VBox>
                    <VBox spacing="4.0">
                        <Label styleClass="filter-label" text="DEPARTMENT" />
                        <ComboBox fx:id="departmentFilter" prefWidth="160.0" promptText="All Departments" />
                    </VBox>
                    <VBox spacing="4.0">
                        <Label styleClass="filter-label" text="EMPLOYEE NAME" />
                        <TextField fx:id="employeeNameFilter" prefWidth="180.0" promptText="Filter by name..." />
                    </VBox>
                    <Pane HBox.hgrow="ALWAYS" />
                    <Button onAction="#handleExportPdf" prefHeight="34.0" prefWidth="130.0" styleClass="btn-outline" text="⬇ EXPORT PDF" />
                    <Button onAction="#handleExportExcel" prefHeight="34.0" prefWidth="140.0" styleClass="btn-outline" text="⬇ EXPORT EXCEL" />
                </HBox>
            </VBox>

            <!-- STAT CARDS -->
            <HBox spacing="14.0">
                <VBox spacing="4.0" styleClass="content-box" HBox.hgrow="ALWAYS">
                    <padding><Insets bottom="14.0" left="16.0" right="16.0" top="14.0" /></padding>
                    <Label styleClass="stat-title" text="TOTAL MOVEMENTS TODAY" />
                    <Label fx:id="totalMovementsLabel" styleClass="stat-value" text="0" />
                </VBox>
                <VBox spacing="4.0" styleClass="content-box" HBox.hgrow="ALWAYS">
                    <padding><Insets bottom="14.0" left="16.0" right="16.0" top="14.0" /></padding>
                    <Label styleClass="stat-title" text="CURRENTLY OUT" />
                    <Label fx:id="currentlyOutLabel" styleClass="stat-value" text="0" />
                </VBox>
                <VBox spacing="4.0" styleClass="content-box-primary" HBox.hgrow="ALWAYS">
                    <padding><Insets bottom="14.0" left="16.0" right="16.0" top="14.0" /></padding>
                    <Label styleClass="stat-title-primary" text="PASS SLIP COMPLIANCE" />
                    <Label fx:id="complianceRateLabel" styleClass="stat-value-primary" text="0.0%" />
                </VBox>
            </HBox>

            <!-- TABLE -->
            <VBox spacing="10.0" styleClass="content-box" VBox.vgrow="ALWAYS">
                <padding><Insets bottom="14.0" left="16.0" right="16.0" top="14.0" /></padding>
                <TableView fx:id="movementLogsTable" prefHeight="220.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="dateColumn" prefWidth="110.0" text="DATE" />
                        <TableColumn fx:id="employeeColumn" prefWidth="170.0" text="EMPLOYEE" />
                        <TableColumn fx:id="reasonColumn" prefWidth="210.0" text="REASON / DESTINATION" />
                        <TableColumn fx:id="timeOutColumn" prefWidth="90.0" text="TIME-OUT" />
                        <TableColumn fx:id="timeInColumn" prefWidth="90.0" text="TIME-IN" />
                        <TableColumn fx:id="durationColumn" prefWidth="90.0" text="DURATION" />
                        <TableColumn fx:id="statusColumn" prefWidth="100.0" text="STATUS" />
                    </columns>
                </TableView>

                <!-- PAGINATION ROW -->
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <Button fx:id="prevPageBtn" onAction="#handlePrevPage" styleClass="btn-page-nav" text="◀ Prev" />
                    <Label fx:id="pageInfoLabel" styleClass="page-info-text" text="Page 1 of 1" />
                    <Button fx:id="nextPageBtn" onAction="#handleNextPage" styleClass="btn-page-nav" text="Next ▶" />
                </HBox>
            </VBox>

            <!-- DETAIL CARD (hidden until a row is selected) -->
            <VBox fx:id="detailCard" managed="false" spacing="8.0" styleClass="detail-card" visible="false">
                <padding><Insets bottom="16.0" left="20.0" right="20.0" top="16.0" /></padding>
                <HBox alignment="CENTER_LEFT" spacing="16.0">
                    <VBox spacing="4.0">
                        <Label styleClass="filter-label" text="TRANSACTION ID" />
                        <Label fx:id="detailTransactionId" styleClass="detail-id" text="#PS-XXXX-XXXXX" />
                    </VBox>
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <Label styleClass="filter-label" text="ISSUED BY" />
                        <Label fx:id="detailEmployee" styleClass="detail-employee" text="-" />
                    </VBox>
                    <VBox spacing="4.0">
                        <Label styleClass="filter-label" text="DEPARTMENT" />
                        <Label fx:id="detailDepartment" styleClass="detail-field" text="-" />
                    </VBox>
                    <VBox spacing="4.0">
                        <Label styleClass="filter-label" text="TIMESTAMP" />
                        <Label fx:id="detailTimestamp" styleClass="detail-field" text="-" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="4.0">
                        <Label styleClass="filter-label" text="STATUS" />
                        <Label fx:id="detailStatus" styleClass="detail-status" text="-" />
                    </VBox>
                </HBox>
                <VBox spacing="4.0">
                    <Label styleClass="filter-label" text="AUTHORIZATION NOTES" />
                    <Label fx:id="detailNotes" styleClass="detail-notes" text="-" wrapText="true" />
                </VBox>
            </VBox>

        </VBox>
    </center>

</BorderPane>
