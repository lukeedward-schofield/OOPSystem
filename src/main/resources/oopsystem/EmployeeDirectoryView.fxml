<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefWidth="1209.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="oopsystem.controller.EmployeeDirectoryController">

   <!-- HEADER -->
   <left>
      <VBox prefWidth="230" styleClass="sidebar" stylesheets="@styling/employeeDirectory.css">
         <padding>
            <Insets bottom="20" left="15" right="15" top="20" />
         </padding>

         <VBox spacing="2">
            <Label styleClass="logo-title" text="Admin Portal" />
            <Label styleClass="logo-subtitle" text="Pass Slip System" />
         </VBox>

         <Region minHeight="30" VBox.vgrow="NEVER" />

         <Button maxWidth="Infinity" text="Dashboard" onAction="#goToDashboard"/>
         <Button maxWidth="Infinity" text="Issue Pass Slip" onAction="#goToIssuePassSlip"/>
         <Button maxWidth="Infinity" text="Movement Logs" onAction="#goToMovementLogs"/>
         <Button maxWidth="Infinity" styleClass="active-menu" text="Employee Directory"/>
         <Button maxWidth="Infinity" text="Reports" onAction="#goToReports"/>

         <Pane VBox.vgrow="ALWAYS"/>

         <Button maxWidth="Infinity" text="Settings" onAction="#goToSettings"/>
         <Button maxWidth="Infinity" text="Logout" onAction="#goToLogout"/>
      </VBox>
   </left>

   <center>
      <VBox spacing="15">

         <padding>
            <Insets bottom="20" left="20" right="20" top="15" />
         </padding>

         <!-- HEADER BAR -->

         <HBox alignment="CENTER_LEFT">

            <Label styleClass="header-title" text="Pass Slip Management" />

            <Pane HBox.hgrow="ALWAYS" />

            <Button text="🔔" />
            <Button text="?" />
            <Button text="👤" />

         </HBox>
         <HBox prefHeight="53.0" prefWidth="1036.0">
            <children>
               <VBox alignment="CENTER_LEFT" prefHeight="53.0" prefWidth="461.0">
                  <children>
                     <Label text="Employee Directory" />
                     <Label prefHeight="17.0" prefWidth="301.0" text="Manage institution staff profiles and official records." />
                  </children>
               </VBox>
               <HBox alignment="CENTER_RIGHT" fillHeight="false" prefHeight="53.0" prefWidth="708.0">
                  <children>
                     <Button fx:id="addEmployeeBtn" focusTraversable="false" mnemonicParsing="false" onAction="#addEmployee" prefHeight="25.0" prefWidth="217.0" style="-fx-background-color: red;" text="+ Add Employee" textFill="WHITE">
                        <font>
                           <Font name="System Bold" size="15.0" />
                        </font>
                     </Button>
                  </children>
               </HBox>
            </children>
         </HBox>

         <!-- STATS -->

         <HBox spacing="12">

            <!-- CARD 1 -->

            <HBox prefWidth="250" spacing="10" styleClass="stat-card">

               <StackPane prefHeight="45" prefWidth="45" styleClass="stat-icon">

                  <Label text="👥" />

               </StackPane>

               <VBox>

                  <Label text="TOTAL STAFF" />

                  <Label styleClass="stat-number" text="1,248" />

               </VBox>

            </HBox>

            <!-- CARD 2 -->

            <HBox prefWidth="250" styleClass="stat-card">

               <StackPane prefHeight="45" prefWidth="45" styleClass="stat-icon">

                  <Label text="🏢" />

               </StackPane>

               <VBox>

                  <Label text="DEPARTMENTS" />
                  <Label styleClass="stat-number" text="24" />

               </VBox>

            </HBox>

            <!-- CARD 3 -->

            <HBox prefWidth="250" styleClass="stat-card">

               <StackPane prefHeight="45" prefWidth="45" styleClass="stat-icon">

                  <Label text="✓" />

               </StackPane>

               <VBox>

                  <Label text="ACTIVE TODAY" />
                  <Label styleClass="stat-number" text="1,102" />

               </VBox>

            </HBox>

            <!-- CARD 4 -->

            <HBox prefWidth="250" styleClass="stat-card">

               <StackPane prefHeight="45" prefWidth="45" styleClass="stat-icon">

                  <Label text="📅" />

               </StackPane>

               <VBox>

                  <Label text="ON LEAVE" />
                  <Label styleClass="stat-number" text="146" />

               </VBox>

            </HBox>

         </HBox>

         <!-- TABLE CONTAINER -->

         <VBox spacing="10" styleClass="table-card" VBox.vgrow="ALWAYS">

            <padding>
               <Insets bottom="15" left="15" right="15" top="15" />
            </padding>

            <!-- TOOLBAR -->

            <HBox spacing="10">

               <TextField fx:id="searchField" promptText="Search by name, ID, or department..." HBox.hgrow="ALWAYS" />

               <Button text="Filters" />

               <Pane HBox.hgrow="ALWAYS" />

               <Button text="⬇" />
               <Button text="🖨" />

            </HBox>

            <!-- TABLE -->

            <TableView fx:id="employeeTable">

               <columns>

                  <TableColumn fx:id="nameColumn" text="Employee Name" />

                  <TableColumn fx:id="idColumn" text="Employee ID" />

                  <TableColumn fx:id="departmentColumn" text="Department" />

                  <TableColumn fx:id="positionColumn" text="Position" />

                  <TableColumn fx:id="contactColumn" text="Contact Info" />

               </columns>

            </TableView>

            <!-- FOOTER -->

            <HBox alignment="CENTER_LEFT">

               <Label text="Showing 1 to 5 of 1,248 entries" />

               <Pane HBox.hgrow="ALWAYS" />

               <Pagination fx:id="pagination" pageCount="250" />
            </HBox>

         </VBox>

      </VBox>
   </center>

</BorderPane>
