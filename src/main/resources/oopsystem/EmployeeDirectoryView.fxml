<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="oopsystem.controller.EmployeeDirectoryController">

   <!-- HEADER -->
   <left>
      <VBox prefWidth="230"
            styleClass="sidebar"
            stylesheets="@styling/employeeDirectory.css">

         <padding>
            <Insets top="20" right="15" bottom="20" left="15"/>
         </padding>

         <!-- Logo -->

         <VBox spacing="2">

            <Label text="Admin Portal"
                   styleClass="logo-title"/>

            <Label text="Pass Slip System"
                   styleClass="logo-subtitle"/>

         </VBox>

         <Region VBox.vgrow="NEVER" minHeight="30"/>

         <!-- Menu -->

         <Button text="Dashboard"
                 maxWidth="Infinity"/>

         <Button text="Issue Pass Slip"
                 maxWidth="Infinity"/>

         <Button text="Movement Logs"
                 maxWidth="Infinity"/>

         <Button text="Employee Directory"
                 maxWidth="Infinity"
                 styleClass="active-menu"/>

         <Button text="Reports"
                 maxWidth="Infinity"/>

         <Pane VBox.vgrow="ALWAYS"/>

         <Button text="Settings"
                 maxWidth="Infinity"/>

         <Button text="Logout"
                 maxWidth="Infinity"/>

      </VBox>
   </left>

   <center>
      <VBox spacing="15">

         <padding>
            <Insets top="15" right="20" bottom="20" left="20"/>
         </padding>

         <!-- HEADER BAR -->

         <HBox alignment="CENTER_LEFT">

            <Label text="Pass Slip Management"
                   styleClass="header-title"/>

            <Pane HBox.hgrow="ALWAYS"/>

            <Button text="🔔"/>
            <Button text="?"/>
            <Button text="👤"/>

         </HBox>

         <!-- PAGE TITLE -->

         <VBox spacing="3">

            <Label text="Employee Directory"
                   styleClass="page-title"/>

            <Label text="Manage institution staff profiles and official records."
                   styleClass="page-subtitle"/>

         </VBox>

         <!-- STATS -->

         <HBox spacing="12">

            <!-- CARD 1 -->

            <HBox prefWidth="250"
                  styleClass="stat-card"
                  spacing="10">

               <StackPane prefWidth="45"
                          prefHeight="45"
                          styleClass="stat-icon">

                  <Label text="👥"/>

               </StackPane>

               <VBox>

                  <Label text="TOTAL STAFF"/>

                  <Label text="1,248"
                         styleClass="stat-number"/>

               </VBox>

            </HBox>

            <!-- CARD 2 -->

            <HBox prefWidth="250"
                  styleClass="stat-card">

               <StackPane prefWidth="45"
                          prefHeight="45"
                          styleClass="stat-icon">

                  <Label text="🏢"/>

               </StackPane>

               <VBox>

                  <Label text="DEPARTMENTS"/>
                  <Label text="24"
                         styleClass="stat-number"/>

               </VBox>

            </HBox>

            <!-- CARD 3 -->

            <HBox prefWidth="250"
                  styleClass="stat-card">

               <StackPane prefWidth="45"
                          prefHeight="45"
                          styleClass="stat-icon">

                  <Label text="✓"/>

               </StackPane>

               <VBox>

                  <Label text="ACTIVE TODAY"/>
                  <Label text="1,102"
                         styleClass="stat-number"/>

               </VBox>

            </HBox>

            <!-- CARD 4 -->

            <HBox prefWidth="250"
                  styleClass="stat-card">

               <StackPane prefWidth="45"
                          prefHeight="45"
                          styleClass="stat-icon">

                  <Label text="📅"/>

               </StackPane>

               <VBox>

                  <Label text="ON LEAVE"/>
                  <Label text="146"
                         styleClass="stat-number"/>

               </VBox>

            </HBox>

         </HBox>

         <!-- TABLE CONTAINER -->

         <VBox spacing="10"
               VBox.vgrow="ALWAYS"
               styleClass="table-card">

            <padding>
               <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <!-- TOOLBAR -->

            <HBox spacing="10">

               <TextField fx:id="searchField"
                          HBox.hgrow="ALWAYS"
                          promptText="Search by name, ID, or department..."/>

               <Button text="Filters"/>

               <Pane HBox.hgrow="ALWAYS"/>

               <Button text="⬇"/>
               <Button text="🖨"/>

            </HBox>

            <!-- TABLE -->

            <TableView fx:id="employeeTable">

               <columns>

                  <TableColumn
                          fx:id="nameColumn"
                          text="Employee Name"/>

                  <TableColumn
                          fx:id="idColumn"
                          text="Employee ID"/>

                  <TableColumn
                          fx:id="departmentColumn"
                          text="Department"/>

                  <TableColumn
                          fx:id="positionColumn"
                          text="Position"/>

                  <TableColumn
                          fx:id="contactColumn"
                          text="Contact Info"/>

               </columns>

            </TableView>

            <!-- FOOTER -->

            <HBox alignment="CENTER_LEFT">

               <Label text="Showing 1 to 5 of 1,248 entries"/>

               <Pane HBox.hgrow="ALWAYS"/>

               <Pagination fx:id="pagination"
                           pageCount="250"/>
            </HBox>

         </VBox>

      </VBox>
   </center>

</BorderPane>