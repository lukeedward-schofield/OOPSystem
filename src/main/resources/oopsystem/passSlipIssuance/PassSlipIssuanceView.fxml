<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1209.0"
            stylesheets="@../styling/Passslip.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="oopsystem.controller.PassSlipIssuanceController">
   <left>
      <fx:include fx:id="navBar" source="../components/Nav.fxml" />
   </left>
   <center>
      <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: #F5F5F5; -fx-padding: 24 32 32 32;">
         <Label text="Issue Pass Slip"/>
         <Label text="Complete the form below to authorize employee departure during office hours."/>

         <HBox spacing="20" VBox.vgrow="ALWAYS">

            <VBox HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
               <VBox VBox.vgrow="ALWAYS" styleClass="form-card">
                  <HBox alignment="CENTER_LEFT">
                     <Label text="Authorization Form" styleClass="Passslip">
                        <font><Font name="System Bold" size="20.0"/></font>
                     </Label>
                  </HBox>
                  <HBox>
                     <VBox HBox.hgrow="ALWAYS">
                        <Label text="SEARCH EMPLOYEE"/>
                        <TextField fx:id="searchEmployeeField" promptText="Type name or department..."/>
                     </VBox>
                     <VBox HBox.hgrow="ALWAYS">
                        <Label text="REASON FOR LEAVING"/>
                        <TextField fx:id="reasonField" promptText="Max 50 characters"/>
                     </VBox>
                  </HBox>
                  <VBox>
                     <Label text="DESTINATION"/>
                     <TextField fx:id="destinationField" maxWidth="Infinity" promptText="Optional"/>
                  </VBox>
                  <HBox>
                     <VBox HBox.hgrow="ALWAYS">
                        <Label text="TIME-OUT (CURRENT)"/>
                        <TextField fx:id="timeOutField"/>
                     </VBox>
                     <VBox HBox.hgrow="ALWAYS">
                        <Label text="DURATION (MINUTES)"/>
                        <TextField fx:id="durationField" promptText="e.g. 30"/>
                     </VBox>
                  </HBox>
                  <Label fx:id="feedbackLabel" wrapText="true"/>
                  <Button fx:id="generateButton"
                          maxWidth="Infinity"
                          prefHeight="40.0"
                          text="Generate Pass Slip"
                          onAction="#handleGeneratePassSlip"/>
               </VBox>
            </VBox>

            <VBox HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" spacing="0" styleClass="preview-card">

               <VBox styleClass="slip-banner" alignment="CENTER">
                  <Label text="PASS SLIP" styleClass="slip-banner-title"/>
                  <Label text="OFFICE OF THE REGISTRAR &amp; ADMIN SERVICES" styleClass="slip-banner-subtitle"/>
               </VBox>

               <VBox spacing="8" style="-fx-padding: 16;" VBox.vgrow="ALWAYS">
                  <HBox spacing="8">
                     <Label text="Employee:" style="-fx-font-weight: bold;" />
                     <Label fx:id="previewEmployee" text="—" />
                  </HBox>
                  <HBox spacing="8">
                     <Label text="Department:" style="-fx-font-weight: bold;" />
                     <Label fx:id="previewDepartment" text="—" />
                  </HBox>
                  <HBox spacing="8">
                     <Label text="Role:" style="-fx-font-weight: bold;" />
                     <Label fx:id="previewRole" text="—" />
                  </HBox>
                  <Label text="─────────────────────────────" />
                  <HBox spacing="8">
                     <Label text="Reason:" style="-fx-font-weight: bold;" />
                     <Label fx:id="previewReason" text="—" wrapText="true" />
                  </HBox>
                  <HBox spacing="8">
                     <Label text="Destination:" style="-fx-font-weight: bold;" />
                     <Label fx:id="previewDestination" text="—" wrapText="true" />
                  </HBox>
                  <Label text="─────────────────────────────" />
                  <HBox spacing="8">
                     <Label text="Time Out:" style="-fx-font-weight: bold;" />
                     <Label fx:id="previewTimeOut" text="—" />
                  </HBox>
                  <HBox spacing="8">
                     <Label text="Duration:" style="-fx-font-weight: bold;" />
                     <Label fx:id="previewDuration" text="—" />
                  </HBox>
                  <HBox spacing="8">
                     <Label text="Est. Return:" style="-fx-font-weight: bold;" />
                     <Label fx:id="previewEstReturn" text="—" />
                  </HBox>
                  <Label text="─────────────────────────────" />
                  <HBox spacing="8">
                     <Label text="Issued By:" style="-fx-font-weight: bold;" />
                     <Label fx:id="previewIssuedBy" text="—" />
                  </HBox>
                  <Button fx:id="downloadPdfButton"
                          maxWidth="Infinity"
                          prefHeight="40.0"
                          text="DOWNLOAD PDF"
                          onAction="#handleDownloadPdf"
                          disable="true">
                     <VBox.margin><Insets top="12.0" /></VBox.margin>
                  </Button>
               </VBox>

            </VBox>

         </HBox>
      </VBox>
   </center>
</BorderPane>