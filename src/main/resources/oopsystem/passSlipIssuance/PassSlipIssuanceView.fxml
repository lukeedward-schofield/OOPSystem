<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity"
            maxWidth="-Infinity"
            minHeight="-Infinity"
            minWidth="-Infinity"
            prefHeight="700.0"
            prefWidth="1209.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="oopsystem.controller.PassSlipIssuanceController">
   <left>
      <fx:include fx:id="navBar" source="../components/Nav.fxml" />
   </left>

   <center>
      <VBox prefHeight="700.0" prefWidth="959.0" BorderPane.alignment="CENTER">
         <children>
            <VBox prefHeight="200.0" prefWidth="100.0" />
            <VBox prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label text="Issue Pass Slip" />
                  <Label text="Complete the form below to authorize employee departure during office hours." />
               </children>
            </VBox>
            <HBox prefHeight="718.0" prefWidth="979.0">
               <children>
                  <VBox alignment="TOP_CENTER" fillWidth="false" prefHeight="609.0" prefWidth="600.0">
                     <children>
                        <VBox alignment="CENTER" fillWidth="false" prefHeight="347.0" prefWidth="531.0" style="-fx-border-color: red;">
                           <children>
                              <HBox alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="482.0">
                                 <children>
                                    <Label text="Authorization Form">
                                       <font>
                                          <Font name="System Bold" size="20.0" />
                                       </font>
                                    </Label>
                                 </children>
                              </HBox>
                              <HBox prefHeight="64.0" prefWidth="486.0" style="-fx-border-color: color;">
                                 <children>
                                    <VBox prefHeight="75.0" prefWidth="238.0">
                                       <children>
                                          <Label text="SEARCH EMPLOYEE" />
                                          <!-- fx:id added; onAction removed — search fires via listener in controller -->
                                          <TextField fx:id="searchEmployeeField" promptText="Type name or department..." />
                                       </children>
                                    </VBox>
                                    <VBox prefHeight="75.0" prefWidth="247.0">
                                       <children>
                                          <Label text="REASON FOR LEAVING" />
                                          <TextField fx:id="reasonField" promptText="Max 50 characters" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                              <VBox fillWidth="false" prefHeight="64.0" prefWidth="482.0">
                                 <children>
                                    <Label text="DESTINATION" />
                                    <TextField fx:id="destinationField" prefHeight="25.0" prefWidth="485.0" promptText="Optional" />
                                 </children>
                              </VBox>
                              <HBox prefHeight="66.0" prefWidth="482.0">
                                 <children>
                                    <VBox prefHeight="76.0" prefWidth="240.0">
                                       <children>
                                          <Label text="TIME-OUT (CURRENT)" />
                                          <!-- editable="false" set in controller via initialize() -->
                                          <TextField fx:id="timeOutField" />
                                       </children>
                                    </VBox>
                                    <VBox prefHeight="76.0" prefWidth="245.0">
                                       <children>
                                          <Label text="ESTIMATED RETURN" />
                                          <!-- For printed slip only — not stored in DB -->
                                          <TextField fx:id="estimatedReturnField" promptText="e.g. 2:00 PM" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                              <!-- Feedback label — sits between fields and button -->
                              <Label fx:id="feedbackLabel" prefWidth="482.0" wrapText="true" />
                              <Button fx:id="generateButton"
                                      mnemonicParsing="false"
                                      prefHeight="25.0"
                                      prefWidth="222.0"
                                      text="Generate Pass Slip"
                                      onAction="#handleGeneratePassSlip" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" fillWidth="false" prefHeight="579.0" prefWidth="410.0" style="-fx-border-color: red;">
                     <children>
                        <!-- Preview panel placeholder — left empty per project decision -->
                        <VBox prefHeight="459.0" prefWidth="338.0" style="-fx-border-color: red;" />
                        <Button fx:id="downloadPdfButton"
                                mnemonicParsing="false"
                                prefHeight="55.0"
                                prefWidth="191.0"
                                text="DOWNLOAD PDF"
                                onAction="#handleDownloadPdf" />
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
</BorderPane>
