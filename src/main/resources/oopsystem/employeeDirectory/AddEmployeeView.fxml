               </TextField>
            </VBox>

            <VBox alignment="CENTER_LEFT" fillWidth="false" prefHeight="125.0" prefWidth="641.0">
               <Label text="Department">
                  <VBox.margin>
                     <Insets left="45.0" />
                  </VBox.margin>
               </Label>
               <TextField fx:id="departmentField" prefWidth="250.0">
                  <VBox.margin>
                     <Insets left="45.0" />
                  </VBox.margin>
               </TextField>
            </VBox>

            <VBox alignment="CENTER_LEFT" fillWidth="false" prefHeight="125.0" prefWidth="641.0">
               <Label text="Role">
