                     <VBox.margin>
                        <Insets left="45.0" />
                     </VBox.margin>
                  </Label>
                  <TextField fx:id="firstNameField" prefHeight="25.0" prefWidth="250.0">
                     <VBox.margin>
                        <Insets left="45.0" />
                     </VBox.margin>
                  </TextField>
               </VBox>
               <VBox alignment="CENTER_LEFT" fillWidth="false" prefHeight="89.0" prefWidth="339.0">
                  <Label text="Last Name">
                     <VBox.margin>
                        <Insets left="40.0" />
                     </VBox.margin>
                  </Label>
                  <TextField fx:id="lastNameField" prefWidth="250.0">
                     <VBox.margin>
                        <Insets left="40.0" />
                     </VBox.margin>
                  </TextField>
               </VBox>
            </HBox>

            <VBox alignment="CENTER_LEFT" fillWidth="false" prefHeight="125.0" prefWidth="641.0">
               <Label text="Contact Number">
                  <VBox.margin>
                     <Insets left="45.0" />
                  </VBox.margin>
               </Label>
               <TextField fx:id="contactNumberField" prefWidth="250.0">
                  <VBox.margin>
                     <Insets left="45.0" />
                  </VBox.margin>
               </TextField>
            </VBox>

            <VBox alignment="CENTER_LEFT" fillWidth="false" prefHeight="125.0" prefWidth="641.0">
               <Label text="Email Address">
                  <VBox.margin>
                     <Insets left="45.0" />
                  </VBox.margin>
               </Label>
               <TextField fx:id="emailField" prefWidth="250.0">
                  <VBox.margin>
                     <Insets left="45.0" />
