         <HBox alignment="CENTER_RIGHT" fillHeight="false" prefHeight="100.0" prefWidth="642.0">
            <Button fx:id="cancelBtn" mnemonicParsing="false" onAction="#handleCancel" prefHeight="43.0" prefWidth="149.0" text="Cancel" textFill="RED">
               <font>
                  <Font name="System Bold" size="17.0" />
               </font>
               <HBox.margin>
                  <Insets left="18.0" right="15.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="addEmployeeBtn" mnemonicParsing="false" onAction="#handleAddEmployee" prefHeight="43.0" prefWidth="149.0" style="-fx-background-color: red;" text="Add Employee" textFill="WHITE">
