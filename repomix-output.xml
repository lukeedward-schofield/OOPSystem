<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="oopsystem.controller.ReportsAnalyticsController"
            prefWidth="1200" prefHeight="850"
            styleClass="app-root"
            stylesheets="@../styling/reports-analytics.css">

    <!-- Left navigation copied visually from the Figma/PDF prototype. -->
    <left>
        <fx:include fx:id="navBar" source="../components/Nav.fxml" />
    </left>

    <center>
        <VBox styleClass="main-area">
            <!-- Top header bar. -->
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="top-bar">
                <Label text="Pass Slip Management" styleClass="top-title" />
                <Region HBox.hgrow="ALWAYS" />
                <Label text="🔔" styleClass="top-icon" />
                <Label text="?" styleClass="top-icon" />
                <Separator orientation="VERTICAL" prefHeight="24" />
                <StackPane styleClass="avatar">
                    <Label text="A" styleClass="avatar-text" />
                </StackPane>
            </HBox>

            <ScrollPane fitToWidth="true" styleClass="page-scroll">
                <VBox spacing="18" styleClass="content-wrapper">
                    <padding>
                        <Insets top="22" right="26" bottom="26" left="26" />
                    </padding>

                    <!-- Hidden field kept so the existing controller can still inject currentlyOutLabel. -->
                    <Label fx:id="currentlyOutLabel" text="0" visible="false" managed="false" />

                    <!-- Data filter row based on the expected Reports screen. -->
                    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="filter-row">
                        <VBox spacing="6">
                            <Label text="DATA FILTERING" styleClass="small-section-label" />
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <DatePicker fx:id="startDatePicker" prefWidth="160" />
                                <Label text="-" styleClass="date-dash" />
                                <DatePicker fx:id="endDatePicker" prefWidth="160" />
                                <Button text="Date Range" onAction="#handleApplyFilters" styleClass="outline-button" />
                            </HBox>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <Button fx:id="exportExcelButton" text="⇩  Export Excel" onAction="#handleExportExcel" styleClass="outline-button" />
                        <Button fx:id="exportPdfButton" text="▣  Export PDF" onAction="#handleExportPdf" styleClass="maroon-button" />
                    </HBox>

                    <!-- Four KPI cards. The expected prototype uses four cards on the Reports page. -->
                    <HBox spacing="16" styleClass="summary-row">
                        <VBox HBox.hgrow="ALWAYS" styleClass="summary-card">
                            <Label text="TOTAL PASS SLIPS" styleClass="summary-title" />
                            <HBox alignment="BOTTOM_LEFT" spacing="12">
                                <Label fx:id="totalPassSlipsLabel" text="0" styleClass="summary-value" />
                                <Label fx:id="totalPassSlipsChangeLabel" text="+0.0%↗" styleClass="positive-change" />
                            </HBox>
                        </VBox>

                        <VBox HBox.hgrow="ALWAYS" styleClass="summary-card">
                            <Label text="COMPLIANCE RATE" styleClass="summary-title" />
                            <HBox alignment="BOTTOM_LEFT" spacing="12">
                                <Label fx:id="complianceRateLabel" text="0.0%" styleClass="summary-value" />
                                <Label fx:id="complianceRateChangeLabel" text="+0.0%↗" styleClass="positive-change" />
                            </HBox>
                        </VBox>

                        <VBox HBox.hgrow="ALWAYS" styleClass="summary-card">
                            <Label text="AVG. DURATION" styleClass="summary-title" />
                            <HBox alignment="BOTTOM_LEFT" spacing="12">
                                <Label fx:id="averageDurationLabel" text="0m" styleClass="summary-value" />
                                <Label fx:id="averageDurationChangeLabel" text="+0m↗" styleClass="positive-change" />
                            </HBox>
                        </VBox>

                        <VBox HBox.hgrow="ALWAYS" styleClass="summary-card">
                            <Label text="OVERDUE PASSES" styleClass="summary-title" />
                            <HBox alignment="BOTTOM_LEFT" spacing="12">
                                <Label fx:id="overduePassesLabel" text="0" styleClass="summary-value" />
                                <Label fx:id="overduePassesChangeLabel" text="+0△" styleClass="positive-change" />
                            </HBox>
                        </VBox>
                    </HBox>

                    <HBox spacing="18">
                        <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="panel trend-panel">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Monthly Movement Trends" styleClass="section-title" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label text="● Official" styleClass="legend-maroon" />
                                <Label text="● Personal" styleClass="legend-olive" />
                            </HBox>

                            <BarChart fx:id="monthlyTrendChart" legendVisible="false" animated="false" prefHeight="250">
                                <xAxis>
                                    <CategoryAxis tickLabelRotation="0" />
                                </xAxis>
                                <yAxis>
                                    <NumberAxis tickLabelsVisible="false" opacity="0.0" />
                                </yAxis>
                            </BarChart>
                        </VBox>

                        <VBox spacing="12" prefWidth="310" styleClass="panel department-panel">
                            <Label text="Departmental Usage" styleClass="section-title" />
                            <TableView fx:id="departmentUsageTable" prefHeight="242" styleClass="department-table">
                                <columns>
                                    <TableColumn fx:id="departmentColumn" text="Department" prefWidth="165" />
                                    <TableColumn fx:id="departmentTotalColumn" text="Slips" prefWidth="60" />
                                    <TableColumn fx:id="departmentPercentageColumn" text="Usage" prefWidth="70" />
                                </columns>
                            </TableView>
                            <Label fx:id="viewAllDepartmentsLabel" text="View All Departments ›" onMouseClicked="#handleViewAllDepartments" styleClass="link-label" />
                        </VBox>
                    </HBox>

                    <VBox spacing="12" styleClass="panel compliance-panel">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Compliance &amp; Overdue Monitoring" styleClass="section-title" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button fx:id="dailyTabButton" text="Daily" onAction="#handleShowDaily" styleClass="tab-button-active" />
                            <Button fx:id="weeklyTabButton" text="Weekly" onAction="#handleShowWeekly" styleClass="tab-button" />
                        </HBox>

                        <TableView fx:id="dailyReportTable" prefHeight="190" styleClass="report-table">
                            <columns>
                                <TableColumn fx:id="reportDateColumn" text="DATE" prefWidth="150" />
                                <TableColumn fx:id="totalIssuedColumn" text="TOTAL ISSUED" prefWidth="170" />
                                <TableColumn fx:id="returnedOnTimeColumn" text="RETURNED ON TIME" prefWidth="190" />
                                <TableColumn fx:id="overdueColumn" text="OVERDUE" prefWidth="130" />
                                <TableColumn fx:id="averageDurationColumn" text="AVG DURATION" prefWidth="1" visible="false" />
                                <TableColumn fx:id="dailyComplianceColumn" text="COMPLIANCE RATE" prefWidth="170" />
                                <TableColumn fx:id="actionColumn" text="ACTION" prefWidth="110" />
                            </columns>
                        </TableView>
                    </VBox>


                    <!-- Hidden status label kept for the controller so backend status messages can still be updated without showing extra content below the table. -->
                    <Label fx:id="statusLabel" text="Ready." visible="false" managed="false" styleClass="status-label" />
                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
</file>

<file path="src/main/resources/oopsystem/styling/dashboard.css">
/* ============================================================
   DASHBOARD — Stylesheet
   ============================================================ */

.root {
    -fx-font-family: "Segoe UI", Arial, sans-serif;
    -fx-font-size: 13px;
    -fx-background-color: #F5F5F5;
}

/* ── CONTENT ───────────────────────────────────────────────── */
.content-scroll { -fx-background-color: transparent; -fx-background: transparent; }
.content-scroll > .viewport { -fx-background-color: #F5F5F5; }
.content-area { -fx-background-color: #F5F5F5; -fx-padding: 24px; }

/* ── CARDS ─────────────────────────────────────────────────── */
.card {
    -fx-background-color: #FFFFFF;
    -fx-background-radius: 8px;
    -fx-border-color: #8B0000;
    -fx-border-radius: 8px;
    -fx-border-width: 1px;
    -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 6, 0, 0, 2);
}
.stat-card {
    -fx-background-color: #FFFFFF;
    -fx-background-radius: 8px;
    -fx-border-color: #8B0000;
    -fx-border-radius: 8px;
    -fx-border-width: 1px;
    -fx-padding: 16px;
    -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 4, 0, 0, 1);
}
.stat-label { -fx-text-fill: #999999; -fx-font-size: 11px; -fx-font-weight: bold; }
.stat-value { -fx-text-fill: #1A1A1A; -fx-font-size: 28px; -fx-font-weight: bold; }
.stat-value-warn { -fx-text-fill: #C07000; -fx-font-size: 28px; -fx-font-weight: bold; }
.stat-note { -fx-text-fill: #999999; -fx-font-size: 11px; }
.stat-note-warn { -fx-text-fill: #D97706; -fx-font-size: 11px; }

/* ── TABLE ─────────────────────────────────────────────────── */
.table-view {
    -fx-background-color: transparent;
    -fx-border-color: transparent;
    -fx-table-cell-border-color: transparent;
    -fx-effect: null;
}
.table-view .column-header-background {
    -fx-background-color: #F9F0F0;
    -fx-border-color: transparent transparent #8B0000 transparent;
    -fx-border-width: 0 0 1.5px 0;
}
.table-view .column-header-background .filler { -fx-background-color: #F9F0F0; }
.table-view .corner { -fx-background-color: #F9F0F0; }
.table-view .column-header { -fx-background-color: transparent; }
.table-view .column-header .label {
    -fx-text-fill: #8B0000;
    -fx-font-size: 11px;
    -fx-font-weight: bold;
    -fx-alignment: CENTER_LEFT;
    -fx-padding: 10px 12px;
}
.table-view .table-cell {
    -fx-text-fill: #1A1A1A;
    -fx-font-size: 12px;
    -fx-padding: 10px 12px;
    -fx-alignment: CENTER_LEFT;
    -fx-border-color: transparent transparent #E8D0D0 transparent;
    -fx-border-width: 0 0 1 0;
}
.table-row-cell { -fx-cell-size: 45px; -fx-border-color: transparent; }
.table-row-cell:even { -fx-background-color: #FFFFFF; }
.table-row-cell:odd  { -fx-background-color: #FDF5F5; }
.table-row-cell:selected { -fx-background-color: #F5E6E6; }
.table-row-cell:selected .table-cell { -fx-text-fill: #1A1A1A; }
.table-row-cell:hover { -fx-background-color: #FAF0F0; }
.table-view .table-row-cell:empty { -fx-background-color: transparent; -fx-border-color: transparent; }

/* ── BUTTONS ───────────────────────────────────────────────── */
.btn-primary {
    -fx-background-color: #8B0000;
    -fx-text-fill: #FFFFFF;
    -fx-font-size: 13px;
    -fx-font-weight: bold;
    -fx-background-radius: 6px;
    -fx-cursor: hand;
    -fx-padding: 8px 18px;
}
.btn-primary:hover { -fx-background-color: #9D0000; }
.btn-primary:pressed { -fx-background-color: #700000; }

.btn-yellow {
    -fx-background-color: #E6A817;
    -fx-text-fill: #FFFFFF;
    -fx-font-size: 12px;
    -fx-font-weight: bold;
    -fx-background-radius: 6px;
    -fx-cursor: hand;
    -fx-padding: 7px 14px;
}
.btn-yellow:hover { -fx-background-color: #C99210; }

.btn-icon {
    -fx-background-color: transparent;
    -fx-cursor: hand;
    -fx-background-radius: 6px;
    -fx-padding: 6px 10px;
    -fx-font-size: 13px;
    -fx-border-color: #DDDDDD;
    -fx-border-radius: 6px;
    -fx-border-width: 1px;
}
.btn-icon:hover { -fx-background-color: #F5F5F5; }

/* ── SECTION ───────────────────────────────────────────────── */
.section-title { -fx-text-fill: #1A1A1A; -fx-font-size: 14px; -fx-font-weight: bold; }
.separator .line { -fx-border-color: #EEEEEE; -fx-border-width: 1 0 0 0; }

.sidebar {
    -fx-background-color: #FFFFFF;
    -fx-border-color: transparent #8B0000 transparent transparent;
    -fx-border-width: 0 1 0 0;
}
.logo-title { -fx-text-fill: #1A1A1A; -fx-font-size: 15px; -fx-font-weight: bold; }
.logo-subtitle { -fx-text-fill: #999999; -fx-font-size: 11px; }
.active-menu {
    -fx-background-color: #FDF5F5;
    -fx-text-fill: #8B0000;
    -fx-font-weight: bold;
    -fx-border-color: transparent transparent transparent #8B0000;
    -fx-border-width: 0 0 0 3px;
    -fx-alignment: CENTER_LEFT;
    -fx-padding: 10px 0 10px 18px;
    -fx-background-radius: 0;
}
</file>

<file path="src/main/java/oopsystem/controller/ProfileController.java">
package oopsystem.controller;

import oopsystem.util.SessionManager;
