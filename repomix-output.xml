   <children>
      <VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #800000;" GridPane.columnIndex="0">
         <padding>
            <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
         </padding>
         <children>
            <FontAwesomeIconView fill="WHITE" glyphName="BOOK" size="100" />
            <Label text="Employee Management System" textAlignment="CENTER" textFill="WHITE" wrapText="true">
               <font>
                  <Font name="System Bold" size="28.0" />
               </font>
            </Label>
         </children>
      </VBox>

      <!-- ADDED: Wrapped right VBox in StackPane to support loading overlay -->
      <StackPane GridPane.columnIndex="1">

         <VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #FFFFFF;">
            <padding>
               <Insets bottom="40.0" left="50.0" right="50.0" top="40.0" />
            </padding>
            <children>

               <VBox spacing="15.0" maxWidth="300.0" alignment="CENTER" VBox.vgrow="NEVER">
                  <children>

                     <Label text="Sign In" textFill="MAROON">
                        <font>
                           <Font name="System Bold" size="24.0" />
                        </font>
                        <VBox.margin>
                           <Insets bottom="10.0" />
                        </VBox.margin>
                     </Label>

                     <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-border-color: #CCCCCC; -fx-border-width: 0 0 1 0; -fx-padding: 5;">
                        <children>
                           <FontAwesomeIconView fill="MAROON" glyphName="USER" size="18" wrappingWidth="20" />
                           <TextField fx:id="usernameField" promptText="Username" style="-fx-background-color: transparent;" HBox.hgrow="ALWAYS" />
                        </children>
                     </HBox>

                     <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-border-color: #CCCCCC; -fx-border-width: 0 0 1 0; -fx-padding: 5;">
                        <children>
                           <FontAwesomeIconView fill="MAROON" glyphName="KEY" size="18" wrappingWidth="20" />
                           <PasswordField fx:id="passwordField" promptText="Password" style="-fx-background-color: transparent;" HBox.hgrow="ALWAYS" />
                        </children>
                     </HBox>

                     <Button fx:id="loginButton" mnemonicParsing="false" onAction="#login"
                             prefHeight="35.0" maxWidth="Infinity"
                             text="Sign in"
                             style="-fx-background-color: #800000; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;">
                        <VBox.margin>
                           <Insets top="10.0" />
                        </VBox.margin>
                     </Button>

                     <Hyperlink text="Forgot password?" textFill="MAROON" />

                  </children>
               </VBox>

            </children>
         </VBox>


         <VBox fx:id="loadingOverlay" alignment="CENTER" spacing="10.0"
               visible="false" managed="false"
               style="-fx-background-color: rgba(255,255,255,0.88);">
            <ProgressIndicator fx:id="loadingSpinner" prefWidth="38.0" prefHeight="38.0"/>
            <Label fx:id="loadingLabel" text="Signing in..."
                   style="-fx-text-fill: #800000; -fx-font-size: 12px; -fx-font-weight: bold;"/>
         </VBox>

      </StackPane>
      <!-- END ADDED -->

   </children>
</GridPane>
</file>

<file path="src/main/resources/oopsystem/passSlipIssuance/PassSlipIssuanceView.fxml">
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!--
   Layout strategy for resize-friendliness:
   - BorderPane fills the scene (no fixed max/min width/height)
   - Center VBox uses VBox.vgrow="ALWAYS" and HBox.hgrow="ALWAYS" so it
     stretches with the window instead of clipping content
   - Fixed prefWidth values are removed from containers; only leaf controls
     (TextFields, Buttons) keep their preferred sizes
   - A ScrollPane wraps the center content so small windows don't clip anything
-->
<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="oopsystem.controller.PassSlipIssuanceController">

   <left>
      <fx:include fx:id="navBar" source="../components/Nav.fxml" />
   </left>

   <center>
      <ScrollPane fitToWidth="true" fitToHeight="true"
                  hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED">
         <content>
            <VBox spacing="12" style="-fx-padding: 24;">
               <VBox.vgrow>ALWAYS</VBox.vgrow>

               <!-- Page header -->
               <Label text="Issue Pass Slip" style="-fx-font-size: 20; -fx-font-weight: bold;" />
               <Label text="Complete the form below to authorize employee departure during office hours."
                      style="-fx-text-fill: #666;" />

               <!-- Two-column content row -->
               <HBox spacing="24" VBox.vgrow="ALWAYS">

                  <!-- LEFT: Authorization Form -->
                  <VBox spacing="12" HBox.hgrow="ALWAYS"
                        style="-fx-border-color: #ccc; -fx-border-radius: 6; -fx-background-color: white;
                               -fx-background-radius: 6; -fx-padding: 20;">

                     <Label text="Authorization Form"
                            style="-fx-font-size: 18; -fx-font-weight: bold;" />

                     <!-- Row 1: Employee + Reason -->
                     <HBox spacing="12">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                           <Label text="SEARCH EMPLOYEE"
                                  style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #555;" />
                           <TextField fx:id="searchEmployeeField"
                                      promptText="Type name or department..."
                                      maxWidth="Infinity" />
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                           <Label text="REASON FOR LEAVING"
                                  style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #555;" />
                           <TextField fx:id="reasonField"
                                      promptText="Max 50 characters"
                                      maxWidth="Infinity" />
                        </VBox>
                     </HBox>

                     <!-- Row 2: Destination (full width) -->
                     <VBox spacing="4">
                        <Label text="DESTINATION"
                               style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #555;" />
                        <TextField fx:id="destinationField"
                                   promptText="Optional"
                                   maxWidth="Infinity" />
                     </VBox>

                     <!-- Row 3: Time Out + Duration -->
                     <HBox spacing="12">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                           <Label text="TIME-OUT (CURRENT)"
                                  style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #555;" />
                           <TextField fx:id="timeOutField" maxWidth="Infinity" />
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                           <Label text="DURATION (MINUTES)"
                                  style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #555;" />
                           <TextField fx:id="durationField"
                                      promptText="e.g. 30"
                                      maxWidth="Infinity" />
                        </VBox>
                     </HBox>

                     <!-- Feedback label -->
                     <Label fx:id="feedbackLabel" wrapText="true" maxWidth="Infinity" />

                     <!-- Generate button -->
                     <Button fx:id="generateButton"
                             text="Generate Pass Slip"
                             onAction="#handleGeneratePassSlip"
                             style="-fx-background-color: #7b1113; -fx-text-fill: white;
                                    -fx-font-weight: bold; -fx-padding: 8 20;"
                             maxWidth="Infinity" />
                  </VBox>

                  <!-- RIGHT: Pass Slip Preview -->
                  <!--
                     fx:id="previewPanel" is used by PassSlipPdfGenerator.generate()
                     to snapshot this node. Do not remove it.
                  -->
                  <VBox HBox.hgrow="ALWAYS" spacing="0" style="-fx-border-color: #ccc; -fx-border-radius: 6;
                  -fx-background-color: white; -fx-background-radius: 6;">

                     <!-- previewSlipContent is what gets snapshotted — button is OUTSIDE it -->
                     <VBox fx:id="previewPanel" spacing="0" minWidth="300">

                        <!-- Header: logo + company -->
                        <HBox alignment="CENTER_LEFT" spacing="14"
                              style="-fx-background-color: #7b1113;
                   -fx-background-radius: 6 6 0 0; -fx-padding: 16 20;">
                           <VBox alignment="CENTER" minWidth="44" minHeight="44"
                                 style="-fx-background-color: rgba(255,255,255,0.15);
                      -fx-border-color: rgba(255,255,255,0.35);
                      -fx-border-width: 1.5; -fx-background-radius: 8;
                      -fx-border-radius: 8;">
                              <!-- Swap this Label with ImageView + logo when ready -->
                              <Label text="LOGO"
                                     style="-fx-text-fill: rgba(255,255,255,0.8);
                          -fx-font-size: 9; -fx-font-weight: bold;" />
                           </VBox>
                           <VBox spacing="2">
                              <!-- Replace with your actual company name -->
                              <Label text="Company Name"
                                     style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;" />
                              <Label text="Human Resources Department"
                                     style="-fx-text-fill: rgba(255,255,255,0.75); -fx-font-size: 11;" />
                           </VBox>
                        </HBox>

                        <!-- Title band -->
                        <HBox alignment="CENTER_LEFT"
                              style="-fx-background-color: #f5f0f0; -fx-padding: 7 20;
                   -fx-border-color: #e0d0d0; -fx-border-width: 0 0 1 0;">
                           <Label text="OFFICIAL PASS SLIP"
                                  style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #7b1113;" />
                           <Region HBox.hgrow="ALWAYS" />
                           <Label fx:id="previewSlipNo" text="No. —"
                                  style="-fx-font-size: 11; -fx-text-fill: #999;" />
                        </HBox>

                        <!-- Employee Information -->
                        <VBox style="-fx-padding: 12 20; -fx-border-color: #eee; -fx-border-width: 0 0 1 0;">
                           <Label text="EMPLOYEE INFORMATION"
                                  style="-fx-font-size: 9; -fx-font-weight: bold; -fx-text-fill: #aaa;
                       -fx-padding: 0 0 8 0;" />
                           <HBox spacing="0">
                              <VBox minWidth="110" spacing="5">
                                 <Label text="Name"       style="-fx-text-fill: #888; -fx-font-size: 12;" />
                                 <Label text="Department" style="-fx-text-fill: #888; -fx-font-size: 12;" />
                                 <Label text="Role"       style="-fx-text-fill: #888; -fx-font-size: 12;" />
                              </VBox>
                              <VBox spacing="5" HBox.hgrow="ALWAYS">
                                 <Label fx:id="previewEmployee"   text="—" wrapText="true"
                                        style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;" />
                                 <Label fx:id="previewDepartment" text="—"
                                        style="-fx-font-size: 12; -fx-text-fill: #333;" />
                                 <Label fx:id="previewRole"       text="—"
                                        style="-fx-font-size: 12; -fx-text-fill: #333;" />
                              </VBox>
                           </HBox>
                        </VBox>

                        <!-- Departure Details -->
                        <VBox style="-fx-padding: 12 20; -fx-border-color: #eee; -fx-border-width: 0 0 1 0;">
                           <Label text="DEPARTURE DETAILS"
                                  style="-fx-font-size: 9; -fx-font-weight: bold; -fx-text-fill: #aaa;
                       -fx-padding: 0 0 8 0;" />
                           <HBox spacing="0">
                              <VBox minWidth="110" spacing="5">
                                 <Label text="Reason"      style="-fx-text-fill: #888; -fx-font-size: 12;" />
                                 <Label text="Destination" style="-fx-text-fill: #888; -fx-font-size: 12;" />
                              </VBox>
                              <VBox spacing="5" HBox.hgrow="ALWAYS">
                                 <Label fx:id="previewReason"      text="—" wrapText="true"
                                        style="-fx-font-size: 12; -fx-text-fill: #333;" />
                                 <Label fx:id="previewDestination" text="—" wrapText="true"
                                        style="-fx-font-size: 12; -fx-text-fill: #333;" />
                              </VBox>
                           </HBox>
                        </VBox>

                        <!-- Time Details -->
                        <VBox style="-fx-padding: 12 20; -fx-border-color: #eee; -fx-border-width: 0 0 1 0;">
                           <Label text="TIME DETAILS"
                                  style="-fx-font-size: 9; -fx-font-weight: bold; -fx-text-fill: #aaa;
                       -fx-padding: 0 0 8 0;" />
                           <HBox spacing="0">
                              <VBox minWidth="110" spacing="5">
                                 <Label text="Time Out"    style="-fx-text-fill: #888; -fx-font-size: 12;" />
                                 <Label text="Duration"    style="-fx-text-fill: #888; -fx-font-size: 12;" />
                                 <Label text="Est. Return" style="-fx-text-fill: #888; -fx-font-size: 12;" />
                              </VBox>
                              <VBox spacing="5" HBox.hgrow="ALWAYS">
                                 <Label fx:id="previewTimeOut"   text="—" style="-fx-font-size: 12; -fx-text-fill: #333;" />
                                 <Label fx:id="previewDuration"  text="—" style="-fx-font-size: 12; -fx-text-fill: #333;" />
                                 <Label fx:id="previewEstReturn" text="—" style="-fx-font-size: 12; -fx-text-fill: #333;" />
                              </VBox>
                           </HBox>
                        </VBox>

                        <!-- Signature lines -->
                        <HBox spacing="24"
                              style="-fx-padding: 12 20 20 20; -fx-border-color: #eee; -fx-border-width: 0 0 1 0;">
                           <VBox HBox.hgrow="ALWAYS" spacing="18">
                              <Label text="ISSUED BY"
                                     style="-fx-font-size: 9; -fx-font-weight: bold; -fx-text-fill: #aaa;" />
                              <VBox spacing="3">
                                 <Label style="-fx-border-color: #ccc; -fx-border-width: 0 0 1 0;
                             -fx-min-width: 120; -fx-min-height: 1;" />
                                 <Label fx:id="previewIssuedBy" text="—"
                                        style="-fx-font-size: 11; -fx-text-fill: #555;" />
                                 <Label text="Authorized signatory"
                                        style="-fx-font-size: 10; -fx-text-fill: #aaa;" />
                              </VBox>
                           </VBox>
                           <VBox HBox.hgrow="ALWAYS" spacing="18">
                              <Label text="RECEIVED BY"
                                     style="-fx-font-size: 9; -fx-font-weight: bold; -fx-text-fill: #aaa;" />
                              <VBox spacing="3">
                                 <Label style="-fx-border-color: #ccc; -fx-border-width: 0 0 1 0;
                             -fx-min-width: 120; -fx-min-height: 1;" />
                                 <Label text="—" style="-fx-font-size: 11; -fx-text-fill: #555;" />
                                 <Label text="Employee signature"
                                        style="-fx-font-size: 10; -fx-text-fill: #aaa;" />
                              </VBox>
                           </VBox>
                        </HBox>

                        <!-- Footer -->
                        <HBox alignment="CENTER_LEFT"
                              style="-fx-padding: 8 20; -fx-background-color: #fafafa;
                   -fx-border-color: #eee; -fx-border-width: 0 0 1 0;">
                           <Label text="Generated by E-Pass Portal"
                                  style="-fx-font-size: 10; -fx-text-fill: #bbb;" />
                           <Region HBox.hgrow="ALWAYS" />
                           <Label fx:id="previewGeneratedAt" text="—"
                                  style="-fx-font-size: 10; -fx-text-fill: #bbb;" />
                        </HBox>

                     </VBox>
                     <!-- Download button is OUTSIDE previewPanel so it won't appear in the snapshot -->
                     <Button fx:id="downloadPdfButton"
                             text="DOWNLOAD PDF"
                             onAction="#handleDownloadPdf"
                             disable="true"
                             maxWidth="Infinity"
                             style="-fx-background-color: #2196F3; -fx-text-fill: white;
                  -fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 10 0;
                  -fx-background-radius: 0 0 6 6;" />
                  </VBox>

               </HBox>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
</file>

<file path="src/main/resources/oopsystem/styling/reports-analytics.css">
/*
 * Reports & Analytics styling.
 * This CSS follows the submitted Figma/PDF look: light sidebar, maroon accents,
 * thin borders, square cards, and a clean administrative dashboard layout.
 */
.root, .app-root {
    -fx-font-family: "Segoe UI", Arial, sans-serif;
    -fx-background-color: #f7f5f4;
    -fx-text-fill: #262020;
}

/* Sidebar */
.sidebar {
    -fx-background-color: #fbfaf9;
    -fx-border-color: transparent #ddcaca transparent transparent;
    -fx-border-width: 0 1 0 0;
}

.sidebar-title {
    -fx-text-fill: #6d0000;
    -fx-font-size: 19px;
    -fx-font-weight: 800;
}

.sidebar-subtitle {
    -fx-text-fill: #544848;
    -fx-font-size: 11px;
}

.sidebar-divider {
    -fx-background-color: #ead9d9;
}

.nav-button, .nav-button-active {
    -fx-background-radius: 0;
    -fx-border-radius: 0;
    -fx-padding: 11 12 11 12;
    -fx-alignment: CENTER_LEFT;
    -fx-font-size: 12px;
    -fx-cursor: hand;
}

.nav-button {
    -fx-background-color: transparent;
    -fx-text-fill: #4c3f3f;
}

.nav-button:hover {
    -fx-background-color: #f0e9e9;
    -fx-text-fill: #710000;
}

.nav-button-active {
    -fx-background-color: #eeeaea;
    -fx-text-fill: #710000;
    -fx-font-weight: 800;
    -fx-border-color: transparent #8b7500 transparent transparent;
    -fx-border-width: 0 3 0 0;
}

/* Main area and top bar */
.main-area {
    -fx-background-color: #f7f5f4;
}

.top-bar {
    -fx-background-color: #fffdfc;
    -fx-padding: 18 26 18 26;
    -fx-border-color: transparent transparent #ddcaca transparent;
    -fx-border-width: 0 0 1 0;
}

.top-title {
    -fx-text-fill: #4d0000;
    -fx-font-size: 14px;
    -fx-font-weight: 800;
}

.top-icon {
    -fx-text-fill: #4d3f3f;
    -fx-font-size: 15px;
}

.avatar {
    -fx-background-color: #194d45;
    -fx-background-radius: 999;
    -fx-min-width: 28;
    -fx-min-height: 28;
    -fx-max-width: 28;
    -fx-max-height: 28;
}

.avatar-text {
    -fx-text-fill: white;
    -fx-font-weight: 800;
}

.page-scroll, .page-scroll > .viewport {
    -fx-background-color: transparent;
    -fx-background: transparent;
}

.content-wrapper {
    -fx-background-color: #f7f5f4;
    -fx-fill-width: true;
}

/* Filter row */
.small-section-label {
    -fx-text-fill: #710000;
    -fx-font-size: 12px;
    -fx-font-weight: 900;
    -fx-letter-spacing: 0.8px;
}

.filter-row {
    -fx-padding: 0 0 2 0;
}

.date-picker, .date-picker .text-field {
    -fx-background-color: #fffdfc;
    -fx-border-color: #d7bcbc;
    -fx-border-radius: 0;
    -fx-background-radius: 0;
    -fx-font-size: 12px;
}

.date-dash {
    -fx-text-fill: #877070;
}

.outline-button, .maroon-button, .tab-button, .tab-button-active {
    -fx-background-radius: 2;
    -fx-border-radius: 2;
    -fx-padding: 7 14 7 14;
    -fx-font-size: 12px;
    -fx-font-weight: 800;
    -fx-cursor: hand;
}

.outline-button {
    -fx-background-color: #fffdfc;
    -fx-text-fill: #710000;
    -fx-border-color: #8a2c2c;
}

.maroon-button {
    -fx-background-color: #710000;
    -fx-text-fill: white;
    -fx-border-color: #710000;
}

/* Cards and panels */
.summary-row {
    -fx-padding: 0 0 6 0;
}

.summary-card, .panel {
    -fx-background-color: #fffdfc;
    -fx-border-color: #d9bebe;
    -fx-border-width: 1;
    -fx-background-radius: 0;
    -fx-border-radius: 0;
}

.summary-card {
    -fx-padding: 16 20 16 20;
    -fx-spacing: 6;
    -fx-min-height: 78;
}

.summary-title {
    -fx-text-fill: #6b5757;
    -fx-font-size: 12px;
    -fx-font-weight: 900;
}

.summary-value {
    -fx-text-fill: #710000;
    -fx-font-size: 25px;
    -fx-font-weight: 900;
}

.positive-change {
    -fx-text-fill: #0b5d4a;
    -fx-font-size: 11px;
    -fx-font-weight: 800;
}

.negative-change {
    -fx-text-fill: #a02b2b;
    -fx-font-size: 11px;
    -fx-font-weight: 800;
}

.panel {
    -fx-padding: 14;
}

.trend-panel {
    -fx-min-height: 230;
}

.department-panel {
    -fx-min-height: 230;
}

.section-title {
    -fx-text-fill: #710000;
    -fx-font-size: 15px;
    -fx-font-weight: 900;
}

.legend-maroon {
    -fx-text-fill: #710000;
    -fx-font-size: 12px;
    -fx-font-weight: 800;
    -fx-padding: 0 8 0 0;
}

.legend-olive {
    -fx-text-fill: #6b6500;
    -fx-font-size: 12px;
    -fx-font-weight: 800;
}

.link-label {
    -fx-text-fill: #710000;
    -fx-font-size: 12px;
    -fx-font-weight: 800;
}

/* Charts */
.chart {
    -fx-background-color: transparent;
    -fx-padding: 0;
}

.chart-plot-background {
    -fx-background-color: transparent;
}

.chart-vertical-grid-lines,
.chart-horizontal-grid-lines {
    -fx-stroke: transparent;
}

.axis {
    -fx-tick-label-fill: #5d4b4b;
    -fx-font-size: 11px;
}

.axis:bottom {
    -fx-border-color: transparent transparent #d7bcbc transparent;
}

.default-color0.chart-bar { -fx-bar-fill: #710000; }
.default-color1.chart-bar { -fx-bar-fill: #6b6500; }
.default-color2.chart-bar { -fx-bar-fill: #c9a000; }

/* Tables */
.table-view {
    -fx-background-color: transparent;
    -fx-border-color: #d9bebe;
    -fx-border-width: 1;
    -fx-background-radius: 0;
    -fx-border-radius: 0;
    -fx-table-cell-border-color: transparent;
}

.table-view .column-header-background {
    -fx-background-color: #e9e7e7;
}

.table-view .column-header, .table-view .filler {
    -fx-background-color: transparent;
    -fx-border-color: transparent;
    -fx-size: 38;
}

.table-view .column-header .label {
    -fx-text-fill: #5e4d4d;
    -fx-font-size: 11px;
    -fx-font-weight: 900;
}

.table-row-cell {
    -fx-background-color: #fffdfc;
    -fx-border-color: transparent transparent #eddada transparent;
    -fx-border-width: 0 0 1 0;
    -fx-cell-size: 34;
}

.table-row-cell:odd {
    -fx-background-color: #f8f8f8;
}

.table-row-cell:selected {
    -fx-background-color: #f1dddd;
}

.table-cell {
    -fx-text-fill: #2c2525;
    -fx-font-size: 12px;
    -fx-alignment: CENTER;
}

.department-table .table-cell:first-child,
.report-table .table-cell:first-child {
    -fx-alignment: CENTER_LEFT;
}

/* Tabs */
.tab-button {
    -fx-background-color: #eeeeee;
    -fx-text-fill: #4f4242;
    -fx-border-color: transparent;
