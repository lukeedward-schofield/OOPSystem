                                <TableColumn fx:id="departmentColumn" minWidth="140" prefWidth="175" text="Department" />
                                <TableColumn fx:id="positionColumn" minWidth="150" prefWidth="190" text="Position" />
                                <TableColumn fx:id="contactColumn" minWidth="180" prefWidth="245" text="Contact Info" />
                                <TableColumn fx:id="actionColumn" minWidth="130" prefWidth="150" text="Actions" />
